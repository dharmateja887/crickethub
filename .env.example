# Copy this file to .env and adjust values as needed.

# Django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=your-secret-key

# Database
# On Vercel, set DATABASE_URL to your Postgres connection string
# (Vercel sets this automatically when you create a Postgres/Neon DB).
DATABASE_URL=

# Local MySQL fallback (used when DATABASE_URL is not set)
DB_NAME=crickethub
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# Google API
GOOGLE_API_KEY=your_google_api_key
